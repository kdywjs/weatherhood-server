WEATHER_DB_USER=weatherhood
WEATHER_DB_PASSWORD=weatherhood_local
WEATHER_DB_NAME=weatherhood
WEATHER_DB_PORT=5432

# 공공데이터포털 출몰시각 정보 활용 승인 후 발급받은 서비스 키
KASI_SERVICE_KEY=

# 카카오 좌표→행정동 조회
KAKAO_REST_API_KEY=

# Apple native iOS 로그인. .p8 원문은 Git 밖의 파일로만 공급한다.
APPLE_CLIENT_ID=co.kr.ansandy.weatherhood
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# 암호학적 난수 32바이트를 Base64로 인코딩한 값. 운영 키를 예제 파일에 넣지 않는다.
AUTH_TOKEN_ENCRYPTION_KEY=
